VITE_MEILISEARCH_SEARCH_KEY=ed7cabcddd7aeeed55e18972f4ec98dccd3c27bf78cb82962d04e1661778011e
VITE_MEILISEARCH_INDEX=products_stage

# ─── WooCommerce (fallback product search) ──────────────────────────────────
VITE_WOOCOMMERCE_URL=https://hotelequip.pt
VITE_WC_KEY=
VITE_WC_SECRET=

# ─── AI (Anthropic) ─────────────────────────────────────────────────────────
VITE_ANTHROPIC_API_KEY=sk-ant-...

# ─── Newsletter desconto ────────────────────────────────────────────────────
VITE_N8N_NEWSLETTER_WEBHOOK=https://n8n.hotelequip.pt/webhook/newsletter-subscribe

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────
# Gerada com: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
VITE_VAPID_PUBLIC_KEY=

# ─── Real-time WebSocket (Directus) ────────────────────────────────────────
# Quando "true", o inbox de Comunicações actualiza via WS (Directus /websocket).
# Requer Directus v11 com extensão WS activa (WEBSOCKETS_ENABLED=true no .env do Directus).
# Default: false (apenas polling 10s).
# VITE_FEATURE_REALTIME_WS=false

