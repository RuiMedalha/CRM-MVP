# ─── Directus ───────────────────────────────────────────────────────────────
VITE_DIRECTUS_URL=https://api.hotelequip.pt
# Token de sessão do utilizador (preenchido em runtime via localStorage)
# VITE_DIRECTUS_TOKEN=
# Token admin para operações de comunicações (polling, Telecof)
# VITE_DIRECTUS_ADMIN_TOKEN=

# ─── Evolution API (WhatsApp 916) ───────────────────────────────────────────
VITE_EVOLUTION_API_URL=https://evolutionapp.profihotel.pt
VITE_EVOLUTION_API_KEY=
VITE_EVOLUTION_INSTANCE=hotelequip-916

# ─── BravoTech ──────────────────────────────────────────────────────────────
VITE_BRAVOTECH_CHAT_URL=https://chat.teambravotech.com

# ─── Newsletter / n8n ───────────────────────────────────────────────────────
VITE_N8N_EVOLUTION_SEND_URL=
VITE_NEWSLETTER_CONSENT_VERSION=v1

# ─── Propostas (Módulo Offerneo) ────────────────────────────────────────────
